  "decision_policy": {
    "FATAL_SCIENTIFIC_DEFECT": {
      "examples": [
        "actual lookahead",
        "actual survivorship contamination",
        "future universe information",
        "impossible execution",
        "material corrupted price data"
      ],
      "result": "BLOCK"
    },
    "METHODOLOGICAL_DIFFERENCE": {
      "examples": [
        "canonical platform universe differs from source paper",
        "different research period",
        "different liquidity convention",
        "different disclosed cost model"
      ],
      "result": "RUN_AND_DISCLOSE"
    },
    "LEGACY_SCOPE_OR_GOVERNANCE_DIFFERENCE": {
      "examples": [
        "capability absent from an older frozen foundation",
        "older experiment disabled next-open execution",
        "preferred wrapper absent",
        "strategy source used a different universe"
      ],
      "result": "VALIDATE_ONCE_REGISTER_AND_REUSE",
      "automatic_block": false
    }
  },
